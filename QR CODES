<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Loly's Romantic Hunt</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;700&family=Playfair+Display:wght@700&display=swap');
    
    body {
      margin: 0; padding: 0;
      background: linear-gradient(135deg, #4a0000, #8b0000);
      color: #ffd700;
      font-family: 'Cormorant Garamond', serif;
      min-height: 100vh;
      overflow-x: hidden;
      position: relative;
    }
    .petals { position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 1; }
    .container {
      position: relative; z-index: 2;
      max-width: 900px; margin: 40px auto; padding: 40px;
      background: rgba(20, 0, 0, 0.75);
      border: 3px solid #ffd700;
      border-radius: 20px;
      box-shadow: 0 0 60px rgba(255, 215, 0, 0.4);
      text-align: center;
    }
    h1 { font-family: 'Playfair Display', serif; font-size: 3.5rem; margin-bottom: 10px; }
    .subtitle { font-style: italic; color: #ff9999; margin-bottom: 40px; }
    .qr-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 30px;
      margin-top: 40px;
    }
    .qr-item {
      background: rgba(255,255,255,0.1);
      padding: 20px;
      border-radius: 15px;
      border: 2px solid #ffd700;
    }
    .qr-item img { width: 180px; height: 180px; background: white; padding: 10px; border-radius: 10px; }
  </style>
</head>
<body>
  <div class="petals" id="petals"></div>
  
  <div class="container">
    <h1>Loly's Romantic Hunt</h1>
    <p class="subtitle">Für meine liebste Killerin ❤️ 10 Stationen voller Liebe & Herausforderung</p>
    
    <div class="qr-grid" id="qrGrid">
      <!-- QR-Codes werden hier per JS generiert -->
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/qrcode.js@1.0.0/qrcode.min.js"></script>
  <script>
    const stations = [
      {num:1, title:"Station 1 – Der Anfang", text:"https://deine-domain.de/station1.html"},
      {num:2, title:"Station 2", text:"https://deine-domain.de/station2.html"},
      // ... bis 10 (du kannst später echte Links oder lokale Dateinamen eintragen)
    ];

    stations.forEach(s => {
      const div = document.createElement('div');
      div.className = 'qr-item';
      div.innerHTML = `
        <h3>Station ${s.num}</h3>
        <div id="qrcode${s.num}"></div>
        <p>${s.title}</p>
      `;
      document.getElementById('qrGrid').appendChild(div);
      
      new QRCode(document.getElementById(`qrcode${s.num}`), {
        text: s.text,
        width: 180,
        height: 180,
        colorDark: "#000000",
        colorLight: "#ffffff"
      });
    });
  </script>
</body>
</html>
